FROM dockerproxy.net/library/ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV AGV_WS=/workspace/AGV_sim_ws
ENV ROS_DISTRO=galactic
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    gnupg2 \
    iproute2 \
    less \
    lsb-release \
    locales \
    nano \
    python3-pip \
    python3-vcstool \
    ripgrep \
    sudo \
    vim \
    wget \
    x11-apps \
  && locale-gen en_US en_US.UTF-8 \
  && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
  && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu focal main" \
    > /etc/apt/sources.list.d/ros2.list

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-rosdep \
    ros-galactic-ros-base \
  && rm -rf /var/lib/apt/lists/*

# Galactic-era Gazebo packages commonly use the ros_ign prefix. Keep this
# best-effort because repository snapshots differ.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-galactic-ros-ign \
    ros-galactic-ros-ign-bridge \
    ros-galactic-ros-ign-gazebo \
    ros-galactic-ros-ign-interfaces \
  || true \
  && rm -rf /var/lib/apt/lists/*

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then \
      rosdep init; \
    fi \
  && rosdep update --rosdistro galactic || true

RUN useradd -m -s /bin/bash -G sudo agv \
  && echo "agv ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/agv \
  && chmod 0440 /etc/sudoers.d/agv

USER agv
WORKDIR ${AGV_WS}

RUN echo "source /opt/ros/galactic/setup.bash" >> /home/agv/.bashrc \
  && echo "if [ -f ${AGV_WS}/install_galactic/setup.bash ]; then source ${AGV_WS}/install_galactic/setup.bash; fi" >> /home/agv/.bashrc

CMD ["/bin/bash"]
